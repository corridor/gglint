---
// The landing page. Starlight's splash template frames it; every section is full width.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path}`;

const columns = ['Claude Code', 'Codex', 'Cursor', 'Gemini CLI', 'Kiro', 'VS Code'];
// s: set up, d: set up differently, m: missing. An illustration of a repository before --fix.
const matrix: [string, string][] = [
	['playwright', 'smdsmd'],
	['linear', 'mmsmsm'],
	['context7', 'ssmsms'],
	['sentry', 'smmmmm'],
];
const toFix = matrix.reduce((n, [, row]) => n + [...row].filter((c) => c !== 's').length, 0);
const label = { s: 'set up', d: 'set up differently', m: 'missing' } as const;

const rules = [
	['missing-server', 'A server in one agent’s config is missing from another’s.', true],
	['missing-config', 'An agent has its own folder, but no MCP config at all.', true],
	['different-server', 'The same server runs another version or other arguments.', true],
	['renamed-server', 'The same server goes by a different name in some agents.', false],
] as const;

// One flat swatch per agent. The colours are decoration, not the agents' brand colours.
const agents = [
	['Claude Code', '.mcp.json', '#1F4BFF', '#fff'],
	['Codex', '.codex/config.toml', '#0A0A0A', '#fff'],
	['Cursor', '.cursor/mcp.json', '#D4FF3A', '#0a0a0a'],
	['OpenCode', 'opencode.json', '#7A3CFF', '#fff'],
	['Amp', '.amp/settings.json', '#00A396', '#0a0a0a'],
	['Antigravity', '.agents/mcp_config.json', '#FF4F7A', '#0a0a0a'],
	['Continue', '.continue/mcpServers/', '#FFD23F', '#0a0a0a'],
	['Copilot CLI', '.github/mcp.json', '#1E8E3E', '#fff'],
	['Crush', '.crush.json', '#8EC5FF', '#0a0a0a'],
	['Factory Droid', '.factory/mcp.json', '#C2185B', '#fff'],
	['Gemini CLI', '.gemini/settings.json', '#5B5BD6', '#fff'],
	['Junie', '.junie/mcp/mcp.json', '#00C2FF', '#0a0a0a'],
	['Kilo Code', 'kilo.json', '#E5243B', '#fff'],
	['Kimi Code', '.kimi-code/mcp.json', '#B7F0D0', '#0a0a0a'],
	['Kiro', '.kiro/settings/mcp.json', '#2E2E2E', '#fff'],
	['Mistral Vibe', '.vibe/config.toml', '#FFB800', '#0a0a0a'],
	['Qoder', '.qoder/settings.json', '#9B51E0', '#fff'],
	['Qwen Code', '.qwen/settings.json', '#0F766E', '#fff'],
	['Trae', '.trae/mcp.json', '#E4E4E7', '#0a0a0a'],
	['VS Code', '.vscode/mcp.json', '#FF8DC1', '#0a0a0a'],
	['Zed', '.zed/settings.json', '#1D3A8A', '#fff'],
] as const;
---

<div class="gg-landing not-content">
	<!-- Hero -->
	<section class="band hero">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<p class="eyebrow mono"><span class="tag ink">v0.5.1</span> MCP sync + secret scanning for coding agents</p>
				<h1 id="_top">Twenty-one agents. <mark>One set</mark> of servers.</h1>
				<p class="lede">
					Claude Code, Codex, Cursor, Gemini CLI and seventeen more each keep MCP servers in their own
					file. gglint finds where they differ, writes the fix in each agent’s format, and keeps tokens
					out of all of them.
				</p>
				<div class="cta-row">
					<div class="cmd mono">
						<span class="dim">$</span><code>uvx gglint mcp</code>
						<button type="button" class="copy" data-copy="uvx gglint mcp" aria-label="Copy the command">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="9" width="12" height="12"></rect><path d="M5 15V3h12"></path></svg>
						</button>
					</div>
					<a class="btn ink mono" href={href('start/quick-start/')}>Quick start →</a>
				</div>
			</div>

			<div class="matrix" data-matrix>
				<div class="matrix-bar mono">
					<span>~/acme-app</span>
					<span class="status" aria-live="polite">
						<span class="when-broken">{toFix} to fix</span>
						<span class="when-fixed">all in sync</span>
					</span>
				</div>
				<div class="matrix-scroll">
					<table class="mono">
						<caption class="sr-only">MCP servers by agent, before and after gglint mcp --fix</caption>
						<thead>
							<tr>
								<th scope="col">server</th>
								{columns.map((c) => <th scope="col">{c}</th>)}
							</tr>
						</thead>
						<tbody>
							{matrix.map(([server, row]) => (
								<tr>
									<th scope="row">{server}</th>
									{[...row].map((c) => (
										<td>
											<span class={`cell ${c}`}>
												<span class="sr-only when-broken">{label[c as 's' | 'd' | 'm']}</span>
												<span class="sr-only when-fixed">set up</span>
											</span>
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<div class="matrix-foot">
					<div class="legend mono">
						<span><i class="key s"></i>set up</span>
						<span><i class="key d"></i>differs</span>
						<span><i class="key m"></i>missing</span>
					</div>
					<button type="button" class="btn ink mono fix" data-fix aria-pressed="false">
						<span class="when-broken">Run --fix →</span>
						<span class="when-fixed">Reset ↺</span>
					</button>
				</div>
			</div>
		</div>
	</section>

	<!-- Numbers -->
	<section class="band ticker mono">
		<div class="wrap ticker-grid">
			<div><b class="signal-text">72%</b><span>of top multi-agent repositories had a problem</span></div>
			<div><b>21</b><span>agents, each read in its own format</span></div>
			<div><b>&lt;1ms</b><span>per check. Starts nothing, fetches nothing</span></div>
			<div><b>0</b><span>secret values ever printed</span></div>
		</div>
	</section>

	<!-- Rules -->
	<section class="band">
		<div class="wrap stack">
			<div class="head-row">
				<h2>Four ways agent configs drift.</h2>
				<p>Each is a rule with its own page. <code class="hl">--fix</code> handles the first three; the fourth is yours to decide.</p>
			</div>
			<div class="rules">
				{rules.map(([slug, text, fixed], i) => (
					<a href={href(`reference/rules/${slug}/`)}>
						<span class="mono dim">{String(i + 1).padStart(2, '0')}</span>
						<span class="mono rule-name">{slug}</span>
						<span class="rule-text">{text}</span>
						<span class={`tag mono ${fixed ? 'signal' : 'ink'}`}>{fixed ? 'fixed by --fix' : 'reported only'}</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Agents -->
	<section class="band">
		<div class="wrap stack">
			<div class="head-row">
				<h2>The whole spectrum of agents.</h2>
				<p>Every chip is a config file gglint reads at your repository’s root, in that agent’s own format.</p>
			</div>
			<ul class="chips">
				{agents.map(([name, file, bg, fg], i) => (
					<li style={`background:${bg};color:${fg}`}>
						<span class="mono num">{String(i + 1).padStart(2, '0')}</span>
						<span class="chip-name">{name}</span>
						<span class="mono chip-file">{file}</span>
					</li>
				))}
			</ul>
			<a class="more mono" href={href('reference/agents/')}>Where each one keeps its servers →</a>
		</div>
	</section>

	<!-- Secrets -->
	<section class="band dark">
		<div class="wrap split">
			<div class="stack">
				<p class="eyebrow mono signal-text">gglint secrets</p>
				<h2>Your agents remember every key you approve.</h2>
				<p class="lede">
					Approve one command in Claude Code and it’s saved, token and all, in
					<code>.claude/settings.local.json</code>. gglint finds secrets in every agent’s settings,
					hooks, rules and MCP files, swaps them for environment variables, and fails the check if a
					personal file is committed.
				</p>
				<a class="btn signal mono" href={href('guides/keep-secrets-out/')}>Keep secrets out →</a>
			</div>
			<div class="redacted mono" aria-label="A config file with a GitHub token, before and after gglint secrets --fix">
				<div class="file-bar"><span>.cursor/mcp.json</span><span class="alarm">✗ inline-secret 5:45</span></div>
				<div class="code">
					<div>"github": {'{'}</div>
					<div class="in">"url": "https://api.githubcopilot.com/mcp/",</div>
					<div class="in">"Authorization": "Bearer <span class="bar" aria-label="redacted secret"></span>"</div>
					<div>{'}'}</div>
				</div>
				<div class="file-bar"><span>$ uvx gglint secrets --fix</span></div>
				<div class="code">
					<div class="in">"Authorization": "Bearer <span class="hl">{'${env:GITHUB_TOKEN}'}</span>"</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Where it runs -->
	<section class="band">
		<div class="wrap runs">
			<a href={href('start/quick-start/')}>
				<span class="mono dim">01 / terminal</span>
				<b>Run it once</b>
				<code>uvx gglint mcp --fix</code>
			</a>
			<a href={href('guides/pre-commit/')}>
				<span class="mono dim">02 / commit</span>
				<b>Stop it at the commit</b>
				<code>uvx gglint hook</code>
			</a>
			<a href={href('guides/github-action/')}>
				<span class="mono dim">03 / pull request</span>
				<b>Catch it in review</b>
				<code>uses: corridor/gglint@v1</code>
			</a>
		</div>
	</section>

	<!-- Closing -->
	<section class="band lime">
		<div class="wrap stack">
			<p class="eyebrow mono">Check your repository now</p>
			<p class="giant mono">uvx gglint mcp</p>
			<div class="cta-row">
				<a class="btn ink mono" href={href('start/quick-start/')}>Quick start →</a>
				<span>Or <code>npx @gglint/cli mcp</code>. Nothing to install. Linux, macOS and Windows.</span>
			</div>
		</div>
	</section>
</div>

<script>
	for (const matrix of document.querySelectorAll<HTMLElement>('[data-matrix]')) {
		const button = matrix.querySelector<HTMLButtonElement>('[data-fix]');
		button?.addEventListener('click', () => {
			const fixed = matrix.toggleAttribute('data-fixed');
			button.setAttribute('aria-pressed', String(fixed));
		});
	}
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.classList.add('copied');
				setTimeout(() => button.classList.remove('copied'), 1200);
			} catch {
				/* Clipboard unavailable: the command is visible to copy by hand. */
			}
		});
	}
</script>

<style>
	.gg-landing {
		--ink: #0a0a0a;
		--signal: #d4ff3a;
		--amber: #ffb800;
		--alarm: #e5243b;
		--line: var(--gg-line);
		--fg: var(--gg-fg);
		--soft: var(--gg-soft);
		--muted: var(--sl-color-gray-4);
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		color: var(--fg);
		font-size: 1rem;
		line-height: 1.5;
	}
	:global(main:has(.gg-landing)) {
		padding-bottom: 0;
	}
	:global(.content-panel:has(.gg-landing)) {
		padding-block: 0;
		border-top: 0;
	}
	.mono {
		font-family: var(--__sl-font-mono);
	}
	.dim {
		color: var(--muted);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.wrap {
		max-width: 85rem;
		margin: 0 auto;
		padding: 0 2rem;
		box-sizing: border-box;
	}
	.band {
		border-bottom: 1px solid var(--line);
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.band > .stack,
	.band > .wrap.stack {
		padding-block: 6rem;
	}
	h1,
	h2 {
		margin: 0;
		color: var(--fg);
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}
	h1 {
		font-size: clamp(3rem, 6.2vw, 5.75rem);
	}
	h2 {
		font-size: clamp(2.25rem, 4.6vw, 4.25rem);
		letter-spacing: -0.05em;
	}
	mark,
	.hl {
		background: var(--signal);
		color: var(--ink);
		padding: 0 0.08em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	code {
		font-family: var(--__sl-font-mono);
	}
	.eyebrow {
		margin: 0;
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		display: flex;
		gap: 0.75rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.lede {
		margin: 0;
		max-width: 36rem;
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.tag {
		font-size: 0.6875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.25rem 0.5rem;
		align-self: flex-start;
	}
	.tag.ink,
	.btn.ink {
		background: var(--ink);
		color: var(--signal);
	}
	.tag.signal,
	.btn.signal {
		background: var(--signal);
		color: var(--ink);
	}
	:global(:root:not([data-theme='light'])) .tag.ink,
	:global(:root:not([data-theme='light'])) .btn.ink {
		background: var(--signal);
		color: var(--ink);
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 3.5rem;
		padding: 0 1.4rem;
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		border: 0;
		cursor: pointer;
		box-sizing: border-box;
	}
	.btn:hover {
		box-shadow: 4px 4px 0 var(--fg);
		transform: translate(-2px, -2px);
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		align-items: center;
	}

	/* Hero */
	.hero-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
		align-items: center;
		padding-block: 4.5rem 5rem;
	}
	.hero-copy {
		flex: 1 1 30rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.cmd {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border: 1px solid var(--line);
		height: 3.5rem;
		padding: 0 0.5rem 0 1.1rem;
		font-size: 1.0625rem;
		box-sizing: border-box;
	}
	.cmd code {
		background: none;
		padding: 0;
		font-size: inherit;
	}
	.copy {
		border: 0;
		background: none;
		color: var(--fg);
		width: 2.75rem;
		height: 2.75rem;
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	.copy.copied {
		background: var(--signal);
		color: var(--ink);
	}

	/* Matrix */
	.matrix {
		flex: 1 1 32rem;
		min-width: 0;
		border: 1px solid var(--line);
		box-shadow: 10px 10px 0 var(--fg);
		background: var(--sl-color-black);
	}
	.matrix-bar,
	.matrix-foot {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1rem;
		flex-wrap: wrap;
	}
	.matrix-bar {
		border-bottom: 1px solid var(--line);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		justify-content: space-between;
	}
	.status > span {
		padding: 0.2rem 0.5rem;
	}
	.status .when-broken {
		background: var(--alarm);
		color: #fff;
	}
	.status .when-fixed {
		background: var(--signal);
		color: var(--ink);
	}
	.matrix-scroll {
		overflow-x: auto;
		/* Holds the hidden labels in the cells, which would otherwise widen a phone's viewport. */
		position: relative;
	}
	table {
		width: 100%;
		min-width: 32rem;
		border-collapse: collapse;
		font-size: 0.75rem;
	}
	th,
	td {
		border: 0;
		padding: 0;
	}
	thead th {
		padding: 0.75rem 0.25rem;
		border-bottom: 1px solid var(--line);
		font-weight: 400;
		text-align: center;
		line-height: 1.25;
		color: var(--fg);
	}
	thead th:first-child,
	tbody th {
		text-align: start;
		padding-inline: 1rem;
		width: 8rem;
	}
	thead th:first-child {
		color: var(--muted);
	}
	tbody th {
		font-weight: 400;
		font-size: 0.875rem;
		height: 4rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	td {
		text-align: center;
		border-inline-start: 1px solid var(--sl-color-hairline);
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.cell {
		display: inline-grid;
		place-items: center;
		width: 1.875rem;
		height: 1.875rem;
		box-sizing: border-box;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: background 0.25s ease, border-color 0.25s ease;
	}
	.cell.s,
	[data-fixed] .cell {
		background: var(--fg);
		border: 0;
	}
	.cell.s::after,
	[data-fixed] .cell::after {
		content: '✓';
		color: var(--signal);
	}
	:global(:root[data-theme='light']) .cell.s::after,
	:global(:root[data-theme='light']) [data-fixed] .cell::after {
		color: var(--signal);
	}
	:global(:root:not([data-theme='light'])) .cell.s::after,
	:global(:root:not([data-theme='light'])) [data-fixed] .cell::after {
		color: var(--ink);
	}
	.matrix:not([data-fixed]) .cell.d {
		background: var(--amber);
	}
	.matrix:not([data-fixed]) .cell.d::after {
		content: '≠';
		color: var(--ink);
	}
	.matrix:not([data-fixed]) .cell.m {
		border: 1.5px dashed var(--alarm);
		background: transparent;
	}
	.when-fixed {
		display: none;
	}
	[data-fixed] .when-fixed {
		display: inline;
	}
	[data-fixed] .when-broken {
		display: none;
	}
	.matrix-foot {
		justify-content: space-between;
	}
	.legend {
		display: flex;
		gap: 0.9rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-2);
		flex-wrap: wrap;
	}
	.legend span {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.key {
		width: 0.75rem;
		height: 0.75rem;
		box-sizing: border-box;
	}
	.key.s {
		background: var(--fg);
	}
	.key.d {
		background: var(--amber);
	}
	.key.m {
		border: 1.5px dashed var(--alarm);
	}
	.btn.fix {
		min-height: 2.75rem;
		font-size: 0.8125rem;
	}

	/* Numbers */
	.ticker {
		background: var(--ink);
		color: #fff;
	}
	.ticker-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		padding: 0;
	}
	.ticker-grid > div {
		padding: 1.75rem 2rem;
		border-inline-end: 1px solid #2a2a2a;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.ticker-grid > div:last-child {
		border-inline-end: 0;
	}
	.ticker b {
		font-family: var(--__sl-font);
		font-size: 3.25rem;
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.1;
		color: #fff;
	}
	.ticker b.signal-text,
	.signal-text {
		color: var(--signal);
	}
	:global(:root[data-theme='light']) .band:not(.dark, .ticker) .signal-text {
		color: var(--ink);
	}
	.ticker span {
		font-size: 0.75rem;
		line-height: 1.6;
		color: #a3a3a3;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	/* Section heads */
	.head-row {
		display: flex;
		gap: 2rem;
		align-items: flex-end;
		flex-wrap: wrap;
	}
	.head-row h2 {
		flex: 1 1 32rem;
	}
	.head-row p {
		flex: 1 1 20rem;
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	/* Rules */
	.rules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		border-top: 1px solid var(--line);
	}
	.rules a {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.75rem 1.5rem 2rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--fg);
		text-decoration: none;
	}
	.rules a:hover .rule-name {
		background: var(--signal);
		color: var(--ink);
	}
	.rule-name {
