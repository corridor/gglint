---
// The landing page: the tagline, the agents gglint reads, and a way into the docs.
// Starlight's splash template frames it; every section is full width.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}/${path}`;

// One flat swatch per agent. The colours are decoration, not the agents' brand colours.
const agents = [
	['Claude Code', '.mcp.json', '#1F4BFF', '#fff'],
	['Codex', '.codex/config.toml', '#0A0A0A', '#fff'],
	['Cursor', '.cursor/mcp.json', '#D4FF3A', '#0a0a0a'],
	['OpenCode', 'opencode.json', '#7A3CFF', '#fff'],
	['Amp', '.amp/settings.json', '#00A396', '#0a0a0a'],
	['Antigravity', '.agents/mcp_config.json', '#FF4F7A', '#0a0a0a'],
	['Continue', '.continue/mcpServers/', '#FFD23F', '#0a0a0a'],
	['Copilot CLI', '.github/mcp.json', '#1E8E3E', '#fff'],
	['Crush', '.crush.json', '#8EC5FF', '#0a0a0a'],
	['Factory Droid', '.factory/mcp.json', '#C2185B', '#fff'],
	['Gemini CLI', '.gemini/settings.json', '#5B5BD6', '#fff'],
	['Junie', '.junie/mcp/mcp.json', '#00C2FF', '#0a0a0a'],
	['Kilo Code', 'kilo.json', '#E5243B', '#fff'],
	['Kimi Code', '.kimi-code/mcp.json', '#B7F0D0', '#0a0a0a'],
	['Kiro', '.kiro/settings/mcp.json', '#2E2E2E', '#fff'],
	['Mistral Vibe', '.vibe/config.toml', '#FFB800', '#0a0a0a'],
	['Qoder', '.qoder/settings.json', '#9B51E0', '#fff'],
	['Qwen Code', '.qwen/settings.json', '#0F766E', '#fff'],
	['Trae', '.trae/mcp.json', '#E4E4E7', '#0a0a0a'],
	['VS Code', '.vscode/mcp.json', '#FF8DC1', '#0a0a0a'],
	['Zed', '.zed/settings.json', '#1D3A8A', '#fff'],
] as const;
---

<div class="gg-landing not-content">
	<!-- Hero -->
	<section class="band hero">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<h1 id="_top">A second pair of eyes on your <mark>coding agents</mark>.</h1>
				<div class="cta-row">
					<a class="btn ink mono" href={href('start/quick-start/')}>Quick start →</a>
				</div>
			</div>

			<!-- The second pair of eyes. The pupils follow the pointer. -->
			<div class="eyes" aria-hidden="true">
				<svg viewBox="0 0 240 240" data-eyes>
					<g class="eye">
						<rect x="38" y="78" width="74" height="84" class="white" />
						<rect x="61" y="106" width="28" height="28" class="pupil" data-pupil />
					</g>
					<g class="eye">
						<rect x="128" y="78" width="74" height="84" class="white" />
						<rect x="151" y="106" width="28" height="28" class="pupil" data-pupil />
					</g>
				</svg>
			</div>
		</div>
	</section>

	<!-- Agents -->
	<section class="band">
		<div class="wrap stack">
			<ul class="chips">
				{agents.map(([name, file, bg, fg], i) => (
					<li style={`background:${bg};color:${fg}`}>
						<span class="mono num">{String(i + 1).padStart(2, '0')}</span>
						<span class="chip-name">{name}</span>
						<span class="mono chip-file">{file}</span>
					</li>
				))}
			</ul>
		</div>
	</section>
</div>

<script>
	// The pupils look toward the pointer, a few units at most, unless motion is reduced.
	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	for (const svg of document.querySelectorAll<SVGSVGElement>('[data-eyes]')) {
		const pupils = [...svg.querySelectorAll<SVGRectElement>('[data-pupil]')];
		if (still) continue;
		window.addEventListener('pointermove', (event) => {
			const box = svg.getBoundingClientRect();
			const dx = event.clientX - (box.left + box.width / 2);
			const dy = event.clientY - (box.top + box.height / 2);
			const length = Math.hypot(dx, dy) || 1;
			const reach = Math.min(1, length / 300);
			const x = (dx / length) * 16 * reach;
			const y = (dy / length) * 18 * reach;
			for (const pupil of pupils) pupil.style.transform = `translate(${x}px, ${y}px)`;
		});
	}
</script>

<style>
	.gg-landing {
		--ink: #0a0a0a;
		--signal: #d4ff3a;
		--amber: #ffb800;
		--alarm: #e5243b;
		--line: var(--gg-line);
		--fg: var(--gg-fg);
		--soft: var(--gg-soft);
		--muted: var(--sl-color-gray-4);
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		color: var(--fg);
		font-size: 1rem;
		line-height: 1.5;
	}
	:global(main:has(.gg-landing)) {
		padding-bottom: 0;
	}
	:global(.content-panel:has(.gg-landing)) {
		padding-block: 0;
		border-top: 0;
	}
	.mono {
		font-family: var(--__sl-font-mono);
	}
	.dim {
		color: var(--muted);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.wrap {
		max-width: 85rem;
		margin: 0 auto;
		padding: 0 2rem;
		box-sizing: border-box;
	}
	.band {
		border-bottom: 1px solid var(--line);
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.band > .stack,
	.band > .wrap.stack {
		padding-block: 6rem;
	}
	h1,
	h2 {
		margin: 0;
		color: var(--fg);
		font-weight: 800;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}
	h1 {
		font-size: clamp(3rem, 6.2vw, 5.75rem);
		/* Room between lines, so the highlight never covers the line above or below. */
		line-height: 1.1;
	}
	h2 {
		font-size: clamp(2.25rem, 4.6vw, 4.25rem);
		letter-spacing: -0.05em;
	}
	mark,
	.hl {
		background: var(--signal);
		color: var(--ink);
		padding: 0 0.08em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	code {
		font-family: var(--__sl-font-mono);
	}
	.eyebrow {
		margin: 0;
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		display: flex;
		gap: 0.75rem;
		align-items: center;
		flex-wrap: wrap;
	}
	.lede {
		margin: 0;
		max-width: 36rem;
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.tag {
		font-size: 0.6875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.25rem 0.5rem;
		align-self: flex-start;
	}
	.tag.ink,
	.btn.ink {
		background: var(--ink);
		color: var(--signal);
	}
	.tag.signal,
	.btn.signal {
		background: var(--signal);
		color: var(--ink);
	}
	:global(:root:not([data-theme='light'])) .tag.ink,
	:global(:root:not([data-theme='light'])) .btn.ink {
		background: var(--signal);
		color: var(--ink);
	}
	.btn {
		display: inline-flex;
		align-items: center;
		min-height: 3.5rem;
		padding: 0 1.4rem;
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		border: 0;
		cursor: pointer;
		box-sizing: border-box;
	}
	.btn:hover {
		box-shadow: 4px 4px 0 var(--fg);
		transform: translate(-2px, -2px);
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		align-items: center;
	}

	/* Hero */
	.hero-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
		align-items: center;
		padding-block: 4.5rem 5rem;
	}
	.hero-copy {
		flex: 1 1 30rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.cmd {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border: 1px solid var(--line);
		height: 3.5rem;
		padding: 0 0.5rem 0 1.1rem;
		font-size: 1.0625rem;
		box-sizing: border-box;
	}
	.cmd code {
		background: none;
		padding: 0;
		font-size: inherit;
	}
	.copy {
		border: 0;
		background: none;
		color: var(--fg);
		width: 2.75rem;
		height: 2.75rem;
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	.copy.copied {
		background: var(--signal);
		color: var(--ink);
	}

	/* Matrix */
	.matrix {
		flex: 1 1 32rem;
		min-width: 0;
		border: 1px solid var(--line);
		box-shadow: 10px 10px 0 var(--fg);
		background: var(--sl-color-black);
	}
	.matrix-bar,
	.matrix-foot {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1rem;
		flex-wrap: wrap;
	}
	.matrix-bar {
		border-bottom: 1px solid var(--line);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		justify-content: space-between;
	}
	.status > span {
		padding: 0.2rem 0.5rem;
	}
	.status .when-broken {
		background: var(--alarm);
		color: #fff;
	}
	.status .when-fixed {
		background: var(--signal);
		color: var(--ink);
	}
	.matrix-scroll {
		overflow-x: auto;
		/* Holds the hidden labels in the cells, which would otherwise widen a phone's viewport. */
		position: relative;
	}
	table {
		width: 100%;
		min-width: 32rem;
		border-collapse: collapse;
		font-size: 0.75rem;
	}
	th,
	td {
		border: 0;
		padding: 0;
	}
	thead th {
		padding: 0.75rem 0.25rem;
		border-bottom: 1px solid var(--line);
		font-weight: 400;
		text-align: center;
		line-height: 1.25;
		color: var(--fg);
	}
	thead th:first-child,
	tbody th {
		text-align: start;
		padding-inline: 1rem;
		width: 8rem;
	}
	thead th:first-child {
		color: var(--muted);
	}
	tbody th {
		font-weight: 400;
		font-size: 0.875rem;
		height: 4rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	td {
		text-align: center;
		border-inline-start: 1px solid var(--sl-color-hairline);
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.cell {
		display: inline-grid;
		place-items: center;
		width: 1.875rem;
		height: 1.875rem;
		box-sizing: border-box;
		font-weight: 600;
		font-size: 0.9375rem;
		transition: background 0.25s ease, border-color 0.25s ease;
	}
	.cell.s,
	[data-fixed] .cell {
		background: var(--fg);
		border: 0;
	}
	.cell.s::after,
	[data-fixed] .cell::after {
		content: '✓';
		color: var(--signal);
	}
	:global(:root[data-theme='light']) .cell.s::after,
	:global(:root[data-theme='light']) [data-fixed] .cell::after {
		color: var(--signal);
	}
	:global(:root:not([data-theme='light'])) .cell.s::after,
	:global(:root:not([data-theme='light'])) [data-fixed] .cell::after {
		color: var(--ink);
	}
	.matrix:not([data-fixed]) .cell.d {
		background: var(--amber);
	}
	.matrix:not([data-fixed]) .cell.d::after {
		content: '≠';
		color: var(--ink);
	}
	.matrix:not([data-fixed]) .cell.m {
		border: 1.5px dashed var(--alarm);
		background: transparent;
	}
	.when-fixed {
		display: none;
	}
	[data-fixed] .when-fixed {
		display: inline;
	}
	[data-fixed] .when-broken {
		display: none;
	}
	.matrix-foot {
		justify-content: space-between;
	}
	.legend {
		display: flex;
		gap: 0.9rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-2);
		flex-wrap: wrap;
	}
	.legend span {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.key {
		width: 0.75rem;
		height: 0.75rem;
		box-sizing: border-box;
	}
	.key.s {
		background: var(--fg);
	}
	.key.d {
		background: var(--amber);
	}
	.key.m {
		border: 1.5px dashed var(--alarm);
	}
	.btn.fix {
		min-height: 2.75rem;
		font-size: 0.8125rem;
	}

	/* Numbers */
	.ticker {
		background: var(--ink);
		color: #fff;
	}
	.ticker-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		padding: 0;
	}
	.ticker-grid > div {
		padding: 1.75rem 2rem;
		border-inline-end: 1px solid #2a2a2a;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.ticker-grid > div:last-child {
		border-inline-end: 0;
	}
	.ticker b {
		font-family: var(--__sl-font);
		font-size: 3.25rem;
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.1;
		color: #fff;
	}
	.ticker b.signal-text,
	.signal-text {
		color: var(--signal);
	}
	:global(:root[data-theme='light']) .band:not(.dark, .ticker) .signal-text {
		color: var(--ink);
	}
	.ticker span {
		font-size: 0.75rem;
		line-height: 1.6;
		color: #a3a3a3;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	/* Section heads */
	.head-row {
		display: flex;
		gap: 2rem;
		align-items: flex-end;
		flex-wrap: wrap;
	}
	.head-row h2 {
		flex: 1 1 32rem;
	}
	.head-row p {
		flex: 1 1 20rem;
		margin: 0;
		font-size: 1.125rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	/* Rules */
	.rules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		border-top: 1px solid var(--line);
	}
	.rules a {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.75rem 1.5rem 2rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--fg);
		text-decoration: none;
	}
	.rules a:hover .rule-name {
		background: var(--signal);
		color: var(--ink);
	}
	.rule-name {
		font-size: 1.25rem;
		font-weight: 600;
		align-self: flex-start;
	}
	.rule-text {
		color: var(--sl-color-gray-2);
	}

	/* Agent chart */
	.chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 0.625rem;
	}
	.chips li {
		height: 10.5rem;
		padding: 1rem;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		margin: 0;
	}
	.chips .num {
		font-size: 0.75rem;
		opacity: 0.8;
		flex-grow: 1;
	}
	.chip-name {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.chip-file {
		font-size: 0.6875rem;
		opacity: 0.85;
		word-break: break-all;
		margin-top: 0.35rem;
	}
	.more {
		align-self: flex-start;
		color: var(--fg);
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		text-decoration: underline;
		text-decoration-color: var(--signal);
		text-decoration-thickness: 3px;
		text-underline-offset: 4px;
	}

	/* Secrets */
	.dark {
		background: var(--ink);
		color: #fff;
	}
	.dark h2 {
		color: #fff;
	}
	.dark .lede {
		color: #bdbdbd;
	}
	.dark code {
		background: none;
		color: #fff;
	}
	.split {
		display: flex;
		flex-wrap: wrap;
		gap: 3.5rem;
		align-items: center;
		padding-block: 6rem;
	}
	.split > .stack {
		flex: 1 1 28rem;
		min-width: 0;
	}
	.redacted {
		flex: 1 1 32rem;
		min-width: 0;
		border: 1px solid #3a3a3a;
		font-size: 0.875rem;
		line-height: 2;
		color: #bdbdbd;
	}
	.file-bar {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 1.1rem;
		border-bottom: 1px solid #3a3a3a;
		color: #8a8a8a;
		flex-wrap: wrap;
	}
	.redacted .file-bar + .code + .file-bar {
		border-top: 1px solid #3a3a3a;
	}
	.alarm {
		color: #ff6b78;
	}
	.code {
		padding: 1rem 1.1rem;
		overflow-x: auto;
	}
	.code .in {
		padding-inline-start: 1.5rem;
	}
	.bar {
		display: inline-block;
		width: 13rem;
		max-width: 40vw;
		height: 1.1em;
		background: #fff;
		vertical-align: middle;
	}

	/* Where it runs */
	.runs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		padding: 0;
	}
	.runs a {
		padding: 3rem 2rem;
		border-inline-end: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		color: var(--fg);
		text-decoration: none;
	}
	.runs a:last-child {
		border-inline-end: 0;
	}
	.runs .dim {
		font-size: 0.8125rem;
		text-transform: uppercase;
	}
	.runs b {
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.runs code {
		background: var(--soft);
		padding: 0.75rem 0.9rem;
		font-size: 0.875rem;
		align-self: stretch;
	}
	.runs a:hover b {
		background: var(--signal);
		color: var(--ink);
		align-self: flex-start;
	}

	/* Closing */
	.lime {
		background: var(--signal);
		color: var(--ink);
	}
	.lime .eyebrow,
	.lime span {
		color: var(--ink);
	}
	.giant {
		margin: 0;
		font-size: clamp(2.25rem, 7vw, 6.5rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		line-height: 1;
		overflow-wrap: anywhere;
	}
	.lime .btn.ink {
		background: var(--ink);
		color: #fff;
	}
	.lime .btn:hover {
		box-shadow: 4px 4px 0 var(--ink);
	}

	/* Eyes */
	.eyes {
		flex: 0 1 26rem;
		aspect-ratio: 1;
		min-width: 14rem;
		background: var(--signal);
		border: 1px solid var(--line);
		box-shadow: 10px 10px 0 var(--fg);
	}
	.eyes svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.eyes .white {
		fill: #fff;
		stroke: var(--ink);
		stroke-width: 6;
	}
	.eyes .pupil {
		fill: var(--ink);
		transition: transform 0.12s ease-out;
	}
	.eyes .eye {
		transform-box: fill-box;
		transform-origin: center;
		animation: blink 6s infinite;
	}
	@keyframes blink {
		0%, 96%, 100% {
			transform: scaleY(1);
		}
		98% {
			transform: scaleY(0.08);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.eyes .eye {
			animation: none;
		}
		.eyes .pupil {
			transition: none;
		}
	}

	@media (max-width: 50rem) {
		/* No sidebar here, so bleed to the screen edge without 100vw, which can widen a phone's viewport. */
		.gg-landing {
			width: auto;
			margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
		}
	}
	@media (max-width: 40rem) {
		.eyes {
			flex-basis: 100%;
			max-width: 18rem;
			box-shadow: 6px 6px 0 var(--fg);
		}
		.matrix {
			box-shadow: 6px 6px 0 var(--fg);
			margin-inline-end: 6px;
		}
		.wrap {
			padding: 0 1rem;
		}
		.ticker-grid > div,
		.runs a {
			border-inline-end: 0;
			border-bottom: 1px solid #2a2a2a;
